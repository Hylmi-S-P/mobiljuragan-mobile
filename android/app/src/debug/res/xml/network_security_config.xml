<?xml version="1.0" encoding="utf-8"?>
<!--
  Konfigurasi keamanan jaringan untuk build debug.

  Hanya build debug yang boleh mengirim permintaan http://, dan hanya ke
  loopback/emulator supaya backend lokal (127.0.0.1:4000 atau 10.0.2.2:4000)
  bisa diuji tanpa sertifikat. Build rilis memakai berkas di src/main/res/xml
  yang menolak seluruh lalu lintas teks-biasa.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
