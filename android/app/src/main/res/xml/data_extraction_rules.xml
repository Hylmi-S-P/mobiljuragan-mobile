<?xml version="1.0" encoding="utf-8"?>
<!--
  Aturan ekstraksi data Android 12 ke atas (dataExtractionRules).

  Aplikasi ini menyimpan data pribadi pelanggan di perangkat: basis data SQLite
  berisi riwayat pesanan beserta dokumen identitas, serta SharedPreferences yang
  memuat nomor telepon dan preferensi pencarian. Data itu tidak boleh ikut
  tersalin ke cadangan cloud maupun ke perangkat baru lewat transfer
  antarperangkat, karena perangkat tujuan bisa dipakai akun lain.

  Berkas basis data Drift selalu disertai -wal dan -shm selama mode WAL aktif,
  sehingga ketiganya harus dikecualikan bersama. Direktori cache aplikasi
  tidak ditulis terpisah karena sudah dikecualikan otomatis oleh Android OS
  (domain="cache" ditolak oleh Android Lint FullBackupContent).
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="mobiljuragan_local_db.sqlite" />
        <exclude domain="database" path="mobiljuragan_local_db.sqlite-wal" />
        <exclude domain="database" path="mobiljuragan_local_db.sqlite-shm" />
        <exclude domain="sharedpref" path="." />
        <exclude domain="file" path="." />
        <exclude domain="external" path="." />
        <exclude domain="root" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="file" path="." />
        <exclude domain="external" path="." />
        <exclude domain="root" path="." />
    </device-transfer>
</data-extraction-rules>
